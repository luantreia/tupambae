# Database
# Para MongoDB Atlas (recomendado):
MONGO_URI=mongodb+srv://username:password@cluster0.xlo0tyl.mongodb.net/tupambae?retryWrites=true&w=majority

# Para desarrollo local:
# MONGO_URI=mongodb://localhost:27017/tupambae

# Si tienes problemas de DNS con SRV records, usa conexión directa:
# MONGO_URI=mongodb://cluster0-shard-00-00.xlo0tyl.mongodb.net:27017,cluster0-shard-00-01.xlo0tyl.mongodb.net:27017,cluster0-shard-00-02.xlo0tyl.mongodb.net:27017/tupambae?ssl=true&replicaSet=atlas-xyz&authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-here

# Server
PORT=5000
NODE_ENV=development

# Optional: External services
EMAIL_SERVICE=your-email-service
EMAIL_API_KEY=your-email-api-key
